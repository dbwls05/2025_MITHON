# 복사해서 .env로 만든 뒤 값을 채운다 (.env는 커밋하지 않는다)
PORT=

# RDS 엔드포인트 (예: xxxx.abcdefg.ap-northeast-2.rds.amazonaws.com)
# 로컬에서 EC2 SSH 터널로 접속할 때는 127.0.0.1 (DB_PORT는 터널 포트, 예: 3307)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# RDS는 true (암호화 + 인증서 검증), 로컬 MySQL은 false
DB_SSL=true

JWT_SECRET=
JWT_EXPIRES_IN=7d

NICE_API_KEY=

# ── 배포 서버(EC2)에서만 설정. 로컬 개발은 비워 둔다 ──
# Nginx 뒤에서 실제 사용자 IP를 쓰기 위한 설정 (로그인 시도 제한에 필요)
TRUST_PROXY=
# API를 부를 수 있는 프론트엔드 주소, 쉼표로 여러 개 (예: https://donut.vercel.app)
# 비워 두면 모두 허용. 프론트를 API와 같은 Nginx에서 제공하면 비워 둬도 된다
CORS_ORIGIN=

# npm test가 쓰는 DB (선택, 기본 donut_test). 테스트가 테이블을 모두 지우므로 반드시 _test로 끝나야 한다
TEST_DB_NAME=