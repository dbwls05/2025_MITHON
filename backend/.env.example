# 복사해서 .env로 만든 뒤 값을 채운다 (.env는 커밋하지 않는다)
PORT=

# RDS 엔드포인트 (예: xxxx.abcdefg.ap-northeast-2.rds.amazonaws.com)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# RDS는 true (암호화 + 인증서 검증), 로컬 MySQL은 false
DB_SSL=true

JWT_SECRET=
JWT_EXPIRES_IN=7d

NICE_API_KEY=

# npm test가 쓰는 DB (선택, 기본 donut_test). 테스트가 테이블을 모두 지우므로 반드시 _test로 끝나야 한다
TEST_DB_NAME=