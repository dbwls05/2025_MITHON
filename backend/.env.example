# 복사해서 .env로 만든 뒤 값을 채운다 (.env는 커밋하지 않는다)
PORT=

# 로컬 개발: Railway MySQL의 공개 주소 (Variables의 MYSQL_PUBLIC_URL, 예: xxx.proxy.rlwy.net / 포트 12345)
# Railway 서버: Variables에서 ${{MySQL.MYSQLHOST}} 참조 (내부망 mysql.railway.internal, 포트 3306)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# 로컬에서 Railway 공개 주소로 접속하면 true (암호화), Railway 내부망·로컬 MySQL은 false
DB_SSL=true

JWT_SECRET=
JWT_EXPIRES_IN=7d

NICE_API_KEY=

# ── 배포 서버(Railway)에서만 설정. 로컬 개발은 비워 둔다 ──
# Railway 프록시 뒤에서 실제 사용자 IP를 쓰기 위한 설정 (로그인 시도 제한에 필요, Railway는 1)
TRUST_PROXY=
# API를 부를 수 있는 프론트엔드 주소, 쉼표로 여러 개 (예: https://donut.vercel.app)
# 비워 두면 모두 허용
CORS_ORIGIN=

# npm test가 쓰는 DB (선택, 기본 donut_test). 테스트가 테이블을 모두 지우므로 반드시 _test로 끝나야 한다
TEST_DB_NAME=